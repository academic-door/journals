    {
      "paper_id": "doi:10.1016/j.jue.2024.103709",
      "sequence": 10,
      "source_sequence": 10,
      "article_type": "research-article",
      "title_en": "Commuting, gender and children",
      "title_cn": "通勤、性别与子女",
      "authors": [
        "Malte Borghorst",
        "Ismir Mulalic",
        "Jos van Ommeren"
      ],
      "abstract_en": "We demonstrate that women with children are much more likely to leave their job when they have a long commute, which is not true for men. Interpreting these results through the lens of a dynamic search model, we demonstrate that commuting costs increase substantially for women after they have children. For women with children, a 12 kilometer increase in commuting distance induces costs equivalent to about 20% of their wage.",
      "abstract_cn": "我们证明，有子女的女性在通勤距离较长时离职的可能性要大得多，而男性则并非如此。通过动态搜寻模型的视角解释这些结果，我们证明女性在有了孩子之后，通勤成本会大幅增加。对于有子女的女性，通勤距离每增加12公里，所产生的成本相当于其工资的约20%。",
      "doi": "10.1016/j.jue.2024.103709",
