    {
      "paper_id": "doi:10.1016/j.jeconom.2023.01.015",
      "sequence": 12,
      "source_sequence": 13,
      "article_type": "research-article",
      "title_en": "The story of GARCH: A personal odyssey",
      "title_cn": "GARCH的故事：一段个人历程",
      "authors": [
        "Tim Bollerslev"
      ],
      "abstract_en": "I provide a brief history of the origins of the GARCH model and my 1986 paper published in the Journal , along with a discussion of how the GARCH model and applications thereof have ﬂourished since then. I also brieﬂy highlight connections to the more recent realized volatility literature.",
