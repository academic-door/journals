---
import { readFileSync } from "node:fs";

interface Props {
  collectionId?: "top5" | "fields";
  kicker?: string;
  heading?: string;
  description?: string;
}

interface JournalSummary {
  journal_id: string;
  latest_issue_url?: string;
  latest_detected_issue_url?: string;
  [key: string]: unknown;
}

const {
  collectionId = "top5",
  kicker = "TOP 5 ECONOMICS JOURNALS",
  heading = "经济学 TOP5 最新卷期",
  description = "按期刊官网顺序整理中英文目录与摘要。",
} = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const publicApi = new URL("../../public/api/v1/", import.meta.url);
const initialCollection = JSON.parse(
  readFileSync(new URL(`collections/${collectionId}.json`, publicApi), "utf8"),
) as { journals: JournalSummary[]; [key: string]: unknown };
const initialJournal = initialCollection.journals.find(
  (journal) => journal.latest_detected_issue_url || journal.latest_issue_url,
);
const initialIssueUrl =
  initialJournal?.latest_detected_issue_url || initialJournal?.latest_issue_url || "";
const initialIssuePath = initialIssueUrl.replace(/^.*\/api\/v1\//, "");
const initialIssue = initialIssuePath
  ? JSON.parse(
      readFileSync(
        new URL(initialIssuePath, publicApi),
        "utf8",
      ),
    )
  : null;
---

<section class="catalog-intro">
  <div>
    <p class="section-kicker">{kicker}</p>
    <h1>{heading}</h1>
    <p>{description}</p>
    <nav class="collection-switcher" aria-label="期刊分类">
      <a class:list={["button", { active: collectionId === "top5" }]} href={base}>TOP5</a>
      <a class:list={["button", { active: collectionId === "fields" }]} href={`${base}fields/`}>领域顶刊</a>
    </nav>
  </div>
  <a id="composer-link" class="button button-primary" href={`${base}composer/`}>
    在 Composer 中编辑
  </a>
</section>

<section
  class:list={["journal-toolbar", `journal-toolbar--${collectionId}`]}
  aria-label="期刊目录工具"
>
  {collectionId === "fields" && (
    <label class="journal-field-filter field-category-filter">
      <span class="sr-only">按研究领域筛选期刊</span>
      <select id="field-filter" aria-label="按研究领域筛选期刊">
        <option value="all">全部领域</option>
        <option value="general">综合顶刊</option>
        <option value="theory">理论与产业组织顶刊</option>
        <option value="public_history_international">公共、经济史与国际顶刊</option>
        <option value="finance">金融顶刊</option>
        <option value="development_applied">发展与应用顶刊</option>
        <option value="urban_macro_labor_metrics_environment">城市、宏观、劳动、计量与环境顶刊</option>
        <option value="agriculture_resources">农业与资源环境顶刊</option>
      </select>
    </label>
  )}
  {collectionId === "fields" ? (
    <label class="journal-field-filter journal-select-filter">
      <span class="sr-only">选择期刊</span>
      <select id="journal-select" aria-label="选择期刊"></select>
    </label>
  ) : (
    <div id="journal-tabs" class="journal-tabs" role="tablist" aria-label="TOP5 期刊"></div>
  )}
  <label class="journal-field-filter issue-history-filter">
    <span class="sr-only">选择卷期</span>
    <select id="issue-history-select" aria-label="选择卷期">
      <option>最新卷期</option>
    </select>
  </label>
  <label class="search-field">
    <span class="sr-only">检索论文</span>
    <input id="paper-search" type="search" placeholder="检索标题、作者或摘要" />
  </label>
  <button id="china-filter" class="button" type="button">仅看中国相关</button>
</section>

<section id="issue-summary" class="issue-summary" aria-live="polite">
  <p class="loading-copy">正在载入最新卷期……</p>
</section>

<section id="article-list" class="article-list" aria-live="polite"></section>

<script is:inline define:vars={{ base, collectionId, initialCollection, initialIssue }}>
  const displayIssueUrl = (journal) =>
    journal?.latest_detected_issue_url || journal?.latest_issue_url || "";
  const initialJournal = initialCollection.journals.find(
    (journal) => displayIssueUrl(journal)
  );
  const state = {
    collection: initialCollection,
    activeJournal: null,
    issue: null,
    issueIndex: null,
    query: "",
    chinaOnly: false,
    field: "all",
    issueCache: new Map(
      initialJournal && initialIssue
        ? [[displayIssueUrl(initialJournal), Promise.resolve(initialIssue)]]
        : []
    ),
    issueIndexCache: new Map(),
  };

  const chinaRelevance = (article) => {
    if (article.china_relevance?.status) return article.china_relevance;
    const title = `${article.title_en || ""} ${article.title_cn || ""}`;
    const abstract = `${article.abstract_en || ""} ${article.abstract_cn || ""}`;
    const strong = /(?:\b(?:evidence from|in|for|of|among|across)\s+(?:rural\s+)?China\b|\bChinese\s+(?:firms|households|cities|workers|students|manufacturers|exporters|provinces)\b|中国(?:企业|家庭|城市|农村|制造|出口|省份|劳动力|学生))/i;
    const titleMatch = /\bChina(?:'s|ese)?\b|\bChinese\b|中国|北京|上海|台湾|香港/i.test(title);
    const abstractMatch = strong.test(abstract);
    return { status: titleMatch || abstractMatch ? "yes" : "no" };
  };

  const escapeHtml = (value = "") =>
    String(value).replace(/[&<>"']/g, (character) => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#039;",
    })[character]);

  const formatDate = (value = "") => {
    const raw = String(value).trim();
    if (!raw) return "";
    const iso = raw.match(/^(\d{4})-(\d{2})/);
    if (iso) return `${iso[1]}年${Number(iso[2])}月`;
    const month = raw.match(/^(January|February|March|April|May|June|July|August|September|October|November|December)\s+(\d{4})$/i);
    if (!month) return raw;
    const months = { january: 1, february: 2, march: 3, april: 4, may: 5, june: 6, july: 7, august: 8, september: 9, october: 10, november: 11, december: 12 };
    return `${month[2]}年${months[month[1].toLowerCase()]}月`;
  };

  const issueLabel = (issue = {}) => {
    const volume = String(issue.volume || "").trim();
    const number = String(issue.issue || "").trim();
    const existing = String(issue.issue_label || "").trim();
    const base = volume ? `Vol. ${volume}` : "";
    if (!number || number.toLowerCase() === "c") return base;
    if (existing) return existing;
    if (/^[ab]$/i.test(number)) return `${base} · Part ${number.toUpperCase()}`;
    if (/^\d+(?:\s*[-–]\s*\d+)?$/.test(number)) return `${base} · No. ${number}`;
    return [base, number].filter(Boolean).join(" · ");
  };

  const issueSortKey = (entry) => {
    const raw = String(entry.publication_date || "").trim();
    const iso = raw.match(/^(\d{4})-(\d{2})/);
    if (iso) return Number(iso[1]) * 100 + Number(iso[2]);
    const chinese = raw.match(/^(\d{4})\s*年\s*(\d{1,2})\s*月/);
    if (chinese) return Number(chinese[1]) * 100 + Number(chinese[2]);
    const month = raw.match(/^(January|February|March|April|May|June|July|August|September|October|November|December)\s+(\d{4})$/i);
    if (month) {
      const months = { january: 1, february: 2, march: 3, april: 4, may: 5, june: 6, july: 7, august: 8, september: 9, october: 10, november: 11, december: 12 };
      return Number(month[2]) * 100 + months[month[1].toLowerCase()];
    }
    return Number(entry.volume || 0) * 100 + Number(entry.issue || 0);
  };

  const fetchIssueUrl = (url) => {
    if (!state.issueCache.has(url)) {
      state.issueCache.set(url, fetch(url).then((response) => {
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        return response.json();
      }));
    }
    return state.issueCache.get(url);
  };

  const fetchIssue = (journal) => fetchIssueUrl(displayIssueUrl(journal));

  const fetchIssueIndex = (journal) => {
    const url = `${base}api/v1/journals/${encodeURIComponent(journal.journal_id)}/issues/index.json`;
    if (!state.issueIndexCache.has(url)) {
      state.issueIndexCache.set(url, fetch(url).then((response) => {
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        return response.json();
      }));
    }
    return state.issueIndexCache.get(url);
  };

  const enabledJournals = () =>
    (state.collection?.journals || []).filter((journal) => displayIssueUrl(journal));

  const visibleJournals = () =>
    (state.collection?.journals || []).filter(
      (journal) => state.field === "all" || journal.field === state.field
    );

  const renderTabs = () => {
    const tabs = document.querySelector("#journal-tabs");
    const select = document.querySelector("#journal-select");
    if (select) {
      const journals = visibleJournals();
      select.innerHTML = journals.map((journal) => `
        <option
          value="${escapeHtml(journal.journal_id)}"
          ${journal.journal_id === state.activeJournal?.journal_id ? "selected" : ""}
          ${displayIssueUrl(journal) ? "" : "disabled"}
        >${escapeHtml(journal.short_name)} · ${escapeHtml(journal.name_cn || journal.name)}</option>
      `).join("");
      select.onchange = () => {
        const journal = state.collection.journals.find(
          (item) => item.journal_id === select.value
        );
        if (journal) loadIssue(journal);
      };
      return;
    }
    if (!tabs) return;
    tabs.innerHTML = visibleJournals().map((journal) => {
      const enabled = Boolean(displayIssueUrl(journal));
      const active = journal.journal_id === state.activeJournal?.journal_id;
      return `
        <button
          type="button"
          role="tab"
          data-journal="${escapeHtml(journal.journal_id)}"
          aria-selected="${active}"
          class="${active ? "active" : ""}"
          ${enabled ? "" : "disabled"}
        >
          ${escapeHtml(journal.short_name)}
          ${enabled ? "" : "<small>接入中</small>"}
        </button>`;
    }).join("");
    tabs.querySelectorAll("button:not(:disabled)").forEach((button) => {
      const warmIssue = () => {
        const journal = state.collection.journals.find(
          (item) => item.journal_id === button.dataset.journal
        );
        if (journal) fetchIssue(journal).catch(() => null);
      };
      button.addEventListener("pointerenter", warmIssue, { once: true });
      button.addEventListener("focus", warmIssue, { once: true });
      button.addEventListener("click", () => {
        const journal = state.collection.journals.find(
          (item) => item.journal_id === button.dataset.journal
        );
        if (journal) loadIssue(journal);
      });
    });
  };

  const renderIssue = () => {
    const summary = document.querySelector("#issue-summary");
    const list = document.querySelector("#article-list");
    const composerLink = document.querySelector("#composer-link");
    if (!state.issue) return;

    const issue = state.issue;
    const quality = issue.quality || {};
    const abstracts = quality.abstract_en_complete || 0;
    const translated = quality.translation_complete || 0;
    const total = issue.research_article_count || issue.articles.length;
    const counts = issue.content_counts || quality.content_counts || {};
    const corrections = counts.corrections || 0;
    const issueCountLabel = `${total} 篇学术文章${corrections ? `，另有 ${corrections} 篇勘误` : ""}`;
    const ready = issue.publication_state === "ready"
      || (abstracts === total && translated === total);
    const publicationDate = formatDate(issue.publication_date);
    composerLink.href = `${base}composer/?journal=${encodeURIComponent(issue.journal_id)}&issue=${encodeURIComponent(issue.issue_id)}`;

    summary.innerHTML = `
      <div class="issue-identity">
        <p class="section-kicker">${escapeHtml(issue.journal_id.toUpperCase())}</p>
        <h2>${escapeHtml(issue.journal_name)}</h2>
        <p>
          ${escapeHtml(issueLabel(issue))}
          ${publicationDate ? ` · ${escapeHtml(publicationDate)}` : ""}
          · ${issueCountLabel}
        </p>
      </div>
      <div class="issue-note-stack">
        <div class="issue-note ${ready ? "complete" : ""}">
          ${ready
            ? "可复制发布"
            : abstracts < total
              ? `等待英文摘要 · ${abstracts}/${total}`
              : `中文翻译中 · ${translated}/${total}`}
        </div>
        <div class="issue-note">中国相关：${issue.articles.filter((article) => chinaRelevance(article).status === "yes").length} 篇</div>
      </div>`;

    const query = state.query.toLocaleLowerCase();
    const articles = issue.articles.filter((article) =>
      (!state.chinaOnly || chinaRelevance(article).status === "yes") &&
      [
        article.title_en,
        article.title_cn,
        article.authors.join(" "),
        article.abstract_en,
        article.abstract_cn,
      ].join(" ").toLocaleLowerCase().includes(query)
    );

    if (!articles.length) {
      const reason = state.chinaOnly
        ? "本期没有识别到中国相关论文；已收录的其他论文仍可点击“显示全部”查看。"
        : state.query
          ? "当前检索条件没有匹配论文；清空搜索即可查看本期全部内容。"
          : "本期文章暂未载入。";
      list.innerHTML = `<p class="empty-state">${escapeHtml(reason)}</p>`;
      return;
    }

    list.innerHTML = articles.map((article) => {
      const englishAbstract = article.abstract_en
        ? `<section class="abstract-panel abstract-en" aria-label="英文摘要">
            <p class="abstract-label">Abstract</p>
            <p>${escapeHtml(article.abstract_en)}</p>
          </section>`
        : article.article_type === "comment"
          ? `<section class="abstract-panel abstract-en" aria-label="英文摘要">
              <p class="abstract-label">Abstract</p>
              <p>This comment has no standalone abstract.</p>
            </section>`
          : "";
      const chineseAbstract = article.abstract_cn
        ? `<section class="abstract-panel abstract-cn" aria-label="中文摘要">
            <p class="abstract-label">摘要</p>
            <p>${escapeHtml(article.abstract_cn)}</p>
          </section>`
        : article.article_type === "comment"
          ? `<section class="abstract-panel abstract-cn" aria-label="中文摘要">
              <p class="abstract-label">摘要</p>
              <p>该评论未提供独立摘要。</p>
            </section>`
          : "";
      const abstractGrid = englishAbstract || chineseAbstract
        ? `<div class="abstract-grid">${englishAbstract}${chineseAbstract}</div>`
        : "";
      return `
      <article class="paper-entry">
        <header class="paper-header">
          <div class="paper-number">${String(article.sequence).padStart(2, "0")}</div>
          <div class="paper-content">
            <h3>${escapeHtml(article.title_cn || article.title_en)}</h3>
            ${article.title_cn ? `<p class="paper-title-en">${escapeHtml(article.title_en)}</p>` : ""}
            <p class="paper-authors">${escapeHtml(article.authors.join(", "))}</p>
          </div>
        </header>
        ${abstractGrid}
        <footer class="paper-meta">
          ${article.doi ? `<span>DOI ${escapeHtml(article.doi)}</span>` : ""}
          <a href="${escapeHtml(article.source_url)}" target="_blank" rel="noreferrer">
            查看期刊原文
          </a>
        </footer>
      </article>`;
    }).join("");
  };

  const renderIssueHistory = () => {
    const select = document.querySelector("#issue-history-select");
    if (!select || !state.activeJournal) return;
    const index = state.issueIndex;
    const entries = [...(index?.issues || [])].sort((left, right) => issueSortKey(right) - issueSortKey(left));
    const detectedId = state.activeJournal.latest_detected_issue_id
      || state.activeJournal.latest_issue_id;
    const readyId = state.activeJournal.latest_ready_issue_id
      || state.activeJournal.latest_issue_id;
    const options = [
      {
        issue_id: detectedId,
        issue_label: state.activeJournal.latest_detected_issue_label
          || state.activeJournal.latest_issue_label
          || "最新卷期",
        publication_date: state.activeJournal.latest_detected_publication_date
          || state.activeJournal.publication_date
          || "",
        url: displayIssueUrl(state.activeJournal),
        latest: true,
        ready: detectedId === readyId,
      },
      ...(readyId && readyId !== detectedId && state.activeJournal.latest_issue_url ? [{
        issue_id: readyId,
        issue_label: state.activeJournal.latest_issue_label || "最近可发布卷期",
        publication_date: state.activeJournal.publication_date || "",
        url: state.activeJournal.latest_issue_url,
        latest: false,
        ready: true,
      }] : []),
      ...entries
        .filter((entry) => entry.issue_id !== detectedId && entry.issue_id !== readyId)
        .map((entry) => ({ ...entry, latest: false, ready: true })),
    ];
    select.innerHTML = options.map((entry) => `
      <option
        value="${escapeHtml(entry.url)}"
        ${entry.issue_id === state.issue?.issue_id ? "selected" : ""}
      >
        ${entry.latest ? "最新 · " : ""}${escapeHtml(entry.issue_label)}
        ${entry.publication_date ? ` · ${escapeHtml(formatDate(entry.publication_date))}` : ""}
      </option>
    `).join("");
    select.disabled = options.length === 0;
    select.title = options.length === 1 ? "目前仅收录这一期" : "选择卷期";
  };

  const resetArticleFilters = () => {
    state.query = "";
    state.chinaOnly = false;
    const searchInput = document.querySelector("#paper-search");
    if (searchInput) searchInput.value = "";
    const chinaToggle = document.querySelector("#china-filter");
    if (chinaToggle) {
      chinaToggle.classList.remove("active");
      chinaToggle.textContent = "仅看中国相关";
    }
  };

  const loadIssueUrl = async (url) => {
    resetArticleFilters();
    state.issue = null;
    document.querySelector("#issue-summary").innerHTML =
      '<p class="loading-copy">正在载入卷期……</p>';
    document.querySelector("#article-list").innerHTML = "";
    state.issue = await fetchIssueUrl(url);
    renderIssueHistory();
    renderIssue();
  };

  const loadIssue = async (journal) => {
    resetArticleFilters();
    state.activeJournal = journal;
    state.issue = null;
    state.issueIndex = null;
    renderTabs();
    document.querySelector("#issue-summary").innerHTML =
      `<p class="loading-copy">正在载入 ${escapeHtml(journal.short_name)} 最新卷期……</p>`;
    document.querySelector("#article-list").innerHTML = "";
    const indexRequest = fetchIssueIndex(journal).catch(() => null);
    state.issue = await fetchIssue(journal);
    renderIssueHistory();
    renderIssue();
    state.issueIndex = await indexRequest;
    renderIssueHistory();
  };

  document.querySelector("#issue-history-select")?.addEventListener("change", (event) => {
    loadIssueUrl(event.target.value).catch((error) => {
      document.querySelector("#issue-summary").innerHTML =
        `<p class="error-message">卷期载入失败：${escapeHtml(error.message)}</p>`;
    });
  });

  document.querySelector("#paper-search")?.addEventListener("input", (event) => {
    state.query = event.target.value.trim();
    renderIssue();
  });

  const chinaToggle = document.querySelector("#china-filter");
  chinaToggle?.addEventListener("click", () => {
    state.chinaOnly = !state.chinaOnly;
    chinaToggle.classList.toggle("active", state.chinaOnly);
    chinaToggle.textContent = state.chinaOnly ? "显示全部" : "仅看中国相关";
    renderIssue();
  });

  const fieldFilter = document.querySelector("#field-filter");
  fieldFilter?.addEventListener("change", async (event) => {
    state.field = event.target.value;
    const journals = visibleJournals().filter((journal) => displayIssueUrl(journal));
    if (!journals.length) {
      state.activeJournal = null;
      renderTabs();
      document.querySelector("#issue-summary").innerHTML =
        '<p class="empty-state">该领域的最新卷期正在接入。</p>';
      document.querySelector("#article-list").innerHTML = "";
      return;
    }
    if (!journals.some((journal) => journal.journal_id === state.activeJournal?.journal_id)) {
      await loadIssue(journals[0]);
    } else {
      renderTabs();
    }
  });

  const scheduleBackgroundPrefetch = (journals) => {
    const warm = () => {
      const candidates = collectionId === "top5"
        ? journals.slice(1)
        : journals
            .filter((journal) => journal.field === initialJournal?.field)
            .slice(1, 6);
      candidates.forEach((journal) => fetchIssue(journal).catch(() => null));
    };
    if ("requestIdleCallback" in window) {
      window.requestIdleCallback(warm, { timeout: 1500 });
    } else {
      window.setTimeout(warm, 600);
    }
  };

  Promise.resolve()
    .then(async () => {
      const journals = enabledJournals();
      renderTabs();
      if (!journals.length) throw new Error("尚无可用期刊数据");
      await loadIssue(journals[0]);
      scheduleBackgroundPrefetch(journals);
    })
    .catch((error) => {
      document.querySelector("#issue-summary").innerHTML =
        `<p class="error-message">目录载入失败：${escapeHtml(error.message)}</p>`;
    });
</script>

