---
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<section class="catalog-intro field-hero">
  <div>
    <p class="section-kicker">ECON FIELD JOURNALS</p>
    <h1>经济学领域顶刊</h1>
    <p>按研究领域浏览 Academic Door 当前监测的 36 本高水平经济学期刊。</p>
    <nav class="collection-switcher" aria-label="期刊分类">
      <a class="button" href={base}>TOP5</a>
      <a class="button active" href={`${base}fields/`} aria-current="page">领域顶刊</a>
    </nav>
  </div>
  <a id="composer-link" class="button button-primary" href={`${base}composer/`}>
    在 Composer 中编辑
  </a>
</section>

<section id="field-directory" aria-labelledby="directory-title">
  <div class="directory-heading">
    <div>
      <p class="section-kicker">JOURNAL DIRECTORY</p>
      <h2 id="directory-title">按领域浏览</h2>
    </div>
    <p id="directory-count">正在载入期刊目录……</p>
  </div>
  <nav id="field-jump-nav" class="field-jump-nav" aria-label="跳转至研究领域"></nav>
  <div id="field-groups" class="field-groups" aria-live="polite"></div>
</section>

<section id="field-detail" hidden>
  <div class="field-detail-nav">
    <button id="directory-back" class="back-button" type="button">← 返回全部领域</button>
    <nav id="peer-journals" class="peer-journals" aria-label="同领域期刊"></nav>
  </div>

  <div class="field-paper-tools">
    <label class="search-field">
      <span class="sr-only">检索论文</span>
      <input id="paper-search" type="search" placeholder="检索标题、作者或摘要" />
    </label>
    <button id="china-filter" class="button" type="button">仅看中国相关</button>
  </div>

  <section id="issue-summary" class="field-issue-summary" aria-live="polite"></section>
  <section id="article-list" class="article-list" aria-live="polite"></section>
</section>

<script is:inline define:vars={{ base }}>
  const collectionUrl = `${base}api/v1/collections/fields.json`;
  const fieldGroups = [
    { id: "general", label: "综合顶刊" },
    { id: "theory", label: "理论与产业组织顶刊" },
    { id: "public_history_international", label: "公共、经济史与国际顶刊" },
    { id: "finance", label: "金融顶刊" },
    { id: "development_applied", label: "发展与应用顶刊" },
    {
      id: "urban_macro_labor_metrics_environment",
      label: "城市、宏观、劳动、计量与环境顶刊",
    },
    { id: "agriculture_resources", label: "农业与资源环境顶刊" },
  ];

  const state = {
    collection: null,
    activeJournal: null,
    issue: null,
    query: "",
    chinaOnly: false,
    issueCache: new Map(),
  };

  const escapeHtml = (value = "") =>
    String(value).replace(/[&<>"']/g, (character) => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#039;",
    })[character]);

  const chinaRelevance = (article) => {
    if (article.china_relevance?.status === "yes") return article.china_relevance;
    const title = `${article.title_en || ""} ${article.title_cn || ""}`;
    const abstract = `${article.abstract_en || ""} ${article.abstract_cn || ""}`;
    const strong = /(?:\b(?:evidence from|in|for|of|among|across)\s+(?:rural\s+)?China\b|\bChinese\s+(?:firms|households|cities|workers|students|manufacturers|exporters|provinces)\b|中国(?:企业|家庭|城市|农村|制造|出口|省份|劳动力|学生))/i;
    const titleMatch = /\bChina(?:'s|ese)?\b|\bChinese\b|中国|北京|上海|台湾|香港/i.test(title);
    return { status: titleMatch || strong.test(abstract) ? "yes" : "no" };
  };

  const formatDate = (value = "") => {
    const raw = String(value).trim();
    if (!raw) return "";
    const iso = raw.match(/^(\d{4})-(\d{2})/);
    if (iso) return `${iso[1]} 年 ${Number(iso[2])} 月`;
    const month = raw.match(/^(January|February|March|April|May|June|July|August|September|October|November|December)\s+(\d{4})$/i);
    if (!month) return raw;
    const months = { january: 1, february: 2, march: 3, april: 4, may: 5, june: 6, july: 7, august: 8, september: 9, october: 10, november: 11, december: 12 };
    return `${month[2]} 年 ${months[month[1].toLowerCase()]} 月`;
  };

  const issueLabel = (journal) =>
    journal.latest_issue_label
    || String(journal.latest_issue_id || "")
      .replace(`${journal.journal_id}-`, "")
      .split("-")
      .filter(Boolean)
      .map((part, index) => index === 0 ? `Vol. ${part}` : `No. ${part.toUpperCase()}`)
      .join(" · ");

  // API 值为 official_verified / pending_official / continuous_publication。
  // 连续出版卷不显示彩色徽标：它不是待办，只是这类卷期没有可复核的官网顺序。
  const VERIFICATION = {
    official_verified: { tone: "verified", label: "官网目录已核对" },
    continuous_publication: { tone: "", label: "连续出版卷 · 按文章编号排列" },
    pending_official: { tone: "pending", label: "目录顺序待官网复核" },
  };

  const verification = (value) =>
    VERIFICATION[value] || VERIFICATION.pending_official;

  const journalById = (journalId) =>
    state.collection?.journals.find((journal) => journal.journal_id === journalId);

  const fetchIssue = (journal) => {
    const url = journal.latest_issue_url;
    if (!state.issueCache.has(url)) {
      state.issueCache.set(url, fetch(url).then((response) => {
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        return response.json();
      }));
    }
    return state.issueCache.get(url);
  };

  const renderDirectory = () => {
    const journals = state.collection?.journals || [];
    const jumpNav = document.querySelector("#field-jump-nav");
    const groups = document.querySelector("#field-groups");
    document.querySelector("#directory-count").textContent =
      `${journals.length} 本期刊 · ${fieldGroups.length} 个研究领域`;

    jumpNav.innerHTML = fieldGroups.map((field) => {
      const count = journals.filter((journal) => journal.field === field.id).length;
      return `<a class="button" href="#field-${escapeHtml(field.id)}">${escapeHtml(field.label)}<span>${count}</span></a>`;
    }).join("");

    groups.innerHTML = fieldGroups.map((field) => {
      const fieldJournals = journals.filter((journal) => journal.field === field.id);
      return `
        <section id="field-${escapeHtml(field.id)}" class="field-group">
          <header class="field-group-heading">
            <h3>${escapeHtml(field.label)}</h3>
            <span>${fieldJournals.length} 本</span>
          </header>
          <div class="field-journal-grid">
            ${fieldJournals.map((journal) => `
              <button
                class="field-journal-card"
                type="button"
                data-journal="${escapeHtml(journal.journal_id)}"
                ${journal.latest_issue_url ? "" : "disabled"}
              >
                <span class="journal-card-topline">
                  <strong>${escapeHtml(journal.short_name)}</strong>
                  <span>${escapeHtml(issueLabel(journal) || "最新卷期待接入")}</span>
                </span>
                <span class="journal-card-cn">${escapeHtml(journal.name_cn || journal.name)}</span>
                <span class="journal-card-en">${escapeHtml(journal.name)}</span>
                <span class="journal-card-meta">
                  ${formatDate(journal.publication_date)
                    ? `<span>${escapeHtml(formatDate(journal.publication_date))}</span>`
                    : ""}
                  <span>${Number(journal.article_count || 0)} 篇</span>
                  <span class="${verification(journal.order_verification).tone
                    ? `issue-note verification ${verification(journal.order_verification).tone}`
                    : ""}">${escapeHtml(verification(journal.order_verification).label)}</span>
                </span>
              </button>`).join("")}
          </div>
        </section>`;
    }).join("");

    groups.querySelectorAll(".field-journal-card:not(:disabled)").forEach((card) => {
      card.addEventListener("click", () => openJournal(card.dataset.journal));
    });
  };

  const renderPeers = () => {
    const peers = (state.collection?.journals || []).filter(
      (journal) => journal.field === state.activeJournal?.field && journal.latest_issue_url
    );
    const nav = document.querySelector("#peer-journals");
    nav.innerHTML = peers.map((journal) => `
      <button
        type="button"
        data-journal="${escapeHtml(journal.journal_id)}"
        class="${journal.journal_id === state.activeJournal?.journal_id ? "active" : ""}"
        aria-current="${journal.journal_id === state.activeJournal?.journal_id ? "true" : "false"}"
      >${escapeHtml(journal.short_name)}</button>`).join("");
    nav.querySelectorAll("button").forEach((button) => {
      button.addEventListener("click", () => openJournal(button.dataset.journal));
    });
  };

  const renderIssue = () => {
    if (!state.issue || !state.activeJournal) return;
    const issue = state.issue;
    const journal = state.activeJournal;
    const quality = issue.quality || {};
    const translated = quality.translation_complete || 0;
    const total = issue.research_article_count || issue.articles.length;
    const publicationDate = formatDate(issue.publication_date);
    const chinaCount = issue.articles.filter(
      (article) => chinaRelevance(article).status === "yes"
    ).length;
    const order = verification(journal.order_verification);

    document.querySelector("#composer-link").href =
      `${base}composer/?journal=${encodeURIComponent(issue.journal_id)}`;
    document.querySelector("#issue-summary").innerHTML = `
      <div class="field-issue-heading">
        <p class="section-kicker">${escapeHtml(journal.short_name)}</p>
        <h2>${escapeHtml(issue.journal_name)}</h2>
        ${journal.name_cn ? `<p class="field-issue-name-cn">${escapeHtml(journal.name_cn)}</p>` : ""}
      </div>
      <p class="field-issue-facts">
        <span>${escapeHtml(issue.issue_label || `Vol. ${issue.volume} · No. ${issue.issue}`)}</span>
        ${publicationDate ? `<span>${escapeHtml(publicationDate)}</span>` : ""}
        <span>${total} 篇学术文章</span>
        <span>${translated === total ? "中英文已整理" : `中文摘要 ${translated}/${total}`}</span>
        <span class="${order.tone ? `issue-note verification ${order.tone}` : ""}">${escapeHtml(order.label)}</span>
        ${chinaCount ? `<span>中国相关 ${chinaCount} 篇</span>` : ""}
      </p>`;

    const query = state.query.toLocaleLowerCase();
    const articles = issue.articles.filter((article) =>
      (!state.chinaOnly || chinaRelevance(article).status === "yes")
      && [
        article.title_en,
        article.title_cn,
        (article.authors || []).join(" "),
        article.abstract_en,
        article.abstract_cn,
      ].join(" ").toLocaleLowerCase().includes(query)
    );

    const list = document.querySelector("#article-list");
    if (!articles.length) {
      list.innerHTML = '<p class="empty-state">没有找到匹配的论文。</p>';
      return;
    }
    list.innerHTML = articles.map((article) => `
      <article class="paper-entry">
        <header class="paper-header">
          <div class="paper-number">${String(article.sequence).padStart(2, "0")}</div>
          <div class="paper-content">
            <h3>${escapeHtml(article.title_cn || article.title_en)}</h3>
            <p class="paper-title-en">${escapeHtml(article.title_en)}</p>
            <p class="paper-authors">${escapeHtml((article.authors || []).join(", "))}</p>
          </div>
        </header>
        <div class="abstract-grid">
          <section class="abstract-panel abstract-en" aria-label="英文摘要">
            <p class="abstract-label">Abstract</p>
            <p>${escapeHtml(article.abstract_en || "English abstract pending.")}</p>
          </section>
          <section class="abstract-panel abstract-cn" aria-label="中文摘要">
            <p class="abstract-label">摘要</p>
            ${article.abstract_cn
              ? `<p>${escapeHtml(article.abstract_cn)}</p>`
              : '<p class="translation-pending">中文摘要正在整理。</p>'}
          </section>
        </div>
        <footer class="paper-meta">
          ${article.doi ? `<span>DOI ${escapeHtml(article.doi)}</span>` : ""}
          <a href="${escapeHtml(article.source_url)}" target="_blank" rel="noreferrer">查看期刊原文</a>
        </footer>
      </article>`).join("");
  };

  const showDirectory = (updateHistory = true) => {
    state.activeJournal = null;
    state.issue = null;
    document.querySelector("#field-directory").hidden = false;
    document.querySelector("#field-detail").hidden = true;
    document.querySelector("#composer-link").href = `${base}composer/`;
    if (updateHistory) history.pushState({}, "", `${base}fields/`);
    window.scrollTo({ top: 0, behavior: "smooth" });
  };

  const openJournal = async (journalId, updateHistory = true) => {
    const journal = journalById(journalId);
    if (!journal?.latest_issue_url) return;
    state.activeJournal = journal;
    state.issue = null;
    document.querySelector("#field-directory").hidden = true;
    document.querySelector("#field-detail").hidden = false;
    renderPeers();
    document.querySelector("#issue-summary").innerHTML =
      `<p class="loading-copy">正在载入 ${escapeHtml(journal.short_name)} 最新卷期……</p>`;
    document.querySelector("#article-list").innerHTML = "";
    if (updateHistory) {
      history.pushState({ journal: journal.journal_id }, "", `${base}fields/?journal=${encodeURIComponent(journal.journal_id)}`);
    }
    window.scrollTo({ top: 0, behavior: "smooth" });
    try {
      state.issue = await fetchIssue(journal);
      renderIssue();
    } catch (error) {
      document.querySelector("#issue-summary").innerHTML =
        `<p class="error-message">目录载入失败：${escapeHtml(error.message)}</p>`;
    }
  };

  document.querySelector("#directory-back")?.addEventListener("click", () => showDirectory());
  document.querySelector("#paper-search")?.addEventListener("input", (event) => {
    state.query = event.target.value.trim();
    renderIssue();
  });
  const chinaToggle = document.querySelector("#china-filter");
  chinaToggle?.addEventListener("click", () => {
    state.chinaOnly = !state.chinaOnly;
    chinaToggle.classList.toggle("active", state.chinaOnly);
    chinaToggle.textContent = state.chinaOnly ? "显示全部" : "仅看中国相关";
    renderIssue();
  });
  window.addEventListener("popstate", () => {
    const journalId = new URLSearchParams(location.search).get("journal");
    if (journalId && journalById(journalId)) openJournal(journalId, false);
    else showDirectory(false);
  });

  fetch(collectionUrl)
    .then((response) => {
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      return response.json();
    })
    .then((collection) => {
      state.collection = collection;
      renderDirectory();
      const journalId = new URLSearchParams(location.search).get("journal");
      if (journalId && journalById(journalId)) openJournal(journalId, false);
    })
    .catch((error) => {
      document.querySelector("#field-groups").innerHTML =
        `<p class="error-message">目录载入失败：${escapeHtml(error.message)}</p>`;
    });
</script>

<style>
  /* 仅定义 TOP5 页没有的目录结构；hero、按钮、状态徽标一律复用 global.css，
     避免第二套设计语言。数值取自 global.css 现有尺度：卡片圆角 14px、
     卡片阴影 0 8px 24px rgb(16 44 36 / 5%)、控件圆角 9px。 */
  .field-hero { border-bottom: 1px solid var(--line); }

  #field-directory { padding: 34px 0 70px; }

  .directory-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
  }

  .directory-heading h2 {
    margin: 0;
    font-family: Georgia, "Noto Serif SC", serif;
    font-size: 1.65rem;
    line-height: 1.25;
  }

  .directory-heading > p { margin: 0; color: var(--muted); font-size: 0.86rem; }

  .field-jump-nav { display: flex; flex-wrap: wrap; gap: 8px; margin: 22px 0 36px; }
  .field-jump-nav .button { display: inline-flex; align-items: center; gap: 7px; }
  .field-jump-nav span { color: var(--muted); font-variant-numeric: tabular-nums; }
  .field-groups { display: grid; gap: 42px; }
  .field-group { scroll-margin-top: 20px; }

  .field-group-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 14px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
  }

  .field-group-heading h3 {
    margin: 0;
    font-family: Georgia, "Noto Serif SC", serif;
    font-size: 1.15rem;
    line-height: 1.3;
  }

  .field-group-heading span { color: var(--muted); font-size: 0.78rem; }

  .field-journal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 18px;
  }

  .field-journal-card {
    display: block;
    min-width: 0;
    padding: 22px 22px 18px;
    color: var(--ink);
    text-align: left;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 8px 24px rgb(16 44 36 / 5%);
    cursor: pointer;
  }

  .field-journal-card:hover:not(:disabled) { border-color: var(--green); }
  .field-journal-card:disabled { color: var(--muted); cursor: default; box-shadow: none; }

  .field-journal-card:focus-visible {
    outline: 2px solid var(--green);
    outline-offset: 2px;
  }

  .journal-card-topline {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 12px;
  }

  .journal-card-topline strong {
    color: var(--green);
    font-size: 0.7rem;
    font-weight: 850;
    letter-spacing: 0.15em;
  }

  .journal-card-topline > span { color: var(--muted); font-size: 0.72rem; text-align: right; }

  .journal-card-cn {
    display: block;
    margin-top: 16px;
    font-family: Georgia, "Noto Serif SC", serif;
    font-size: 1.04rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .journal-card-en {
    display: -webkit-box;
    min-height: 2.6em;
    margin-top: 6px;
    overflow: hidden;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.45;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .journal-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin-top: 16px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.72rem;
  }

  .journal-card-meta .issue-note { font-size: 0.68rem; }

  #field-detail { padding-bottom: 70px; }
  #field-detail[hidden], #field-directory[hidden] { display: none; }

  .field-detail-nav {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }

  .back-button {
    flex: 0 0 auto;
    padding: 8px 0;
    color: var(--green);
    background: transparent;
    border: 0;
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 750;
  }

  .peer-journals { display: flex; flex-wrap: wrap; gap: 2px; }

  .peer-journals button {
    min-height: 42px;
    padding: 7px 10px;
    color: inherit;
    background: transparent;
    border: 0;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 850;
  }

  .peer-journals button:hover { background: var(--green-soft); }
  .peer-journals button.active { color: white; background: var(--green); }

  .field-paper-tools {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px;
    padding: 18px 0 0;
  }

  .field-issue-summary { padding: 30px 0 22px; }

  .field-issue-heading h2 {
    margin: 0;
    font-family: Georgia, "Noto Serif SC", serif;
    font-size: 1.65rem;
    line-height: 1.3;
  }

  .field-issue-name-cn { margin: 5px 0 0; color: var(--muted); }

  .field-issue-facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    margin: 16px 0 0;
    padding: 12px 0;
    color: var(--muted);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    font-size: 0.78rem;
  }

  @media (max-width: 760px) {
    .directory-heading { align-items: start; }
    .field-journal-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .field-detail-nav { align-items: start; flex-direction: column; gap: 6px; }
    .field-paper-tools { align-items: stretch; flex-direction: column; }
    .field-paper-tools .search-field input { width: 100%; margin-top: 0; }
  }

  @media (max-width: 520px) {
    .field-journal-grid { grid-template-columns: 1fr; }
    .field-jump-nav { display: grid; grid-template-columns: 1fr 1fr; }
    .field-jump-nav a { justify-content: space-between; }
  }
</style>
