---
import Layout from "../../layouts/Layout.astro";
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout
  title="页面已迁移 · Academic Door"
  description="这个页面已停用。请前往发布预览查看期刊文章排版示例。"
  noindex
>
  <main class="simple-page retirement-page">
    <p class="section-kicker">PAGE MOVED</p>
    <h1>此页面已停止使用</h1>
    <p>
      想查看期刊文章的排版示例？请前往“发布预览”。
    </p>
    <div class="retirement-actions">
      <a class="button button-primary" href={`${base}composer/`}>查看发布预览</a>
      <a class="button" href={base}>返回 Academic Door · 期刊</a>
    </div>
  </main>
</Layout>
