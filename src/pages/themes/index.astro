---
import Layout from "../../layouts/Layout.astro";
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout
  title="Theme Lab 已迁移 · Academic Door"
  description="Academic Door 公开 Theme Lab 已退役；发布主题与渲染逻辑现由受保护的 Composer 工作台维护。"
  noindex
>
  <main class="simple-page retirement-page">
    <p class="section-kicker">RETIRED PUBLIC SURFACE</p>
    <h1>Theme Lab 已迁移到内部 Composer</h1>
    <p>
      公开 Theme Lab 已停止提供。主题实验、渲染规则、自定义样式与发布工作流属于受保护的 Composer 工作台，
      不再匿名发布在 Journals 网站。
    </p>
    <div class="retirement-actions">
      <a class="button button-primary" href={`${base}composer/`}>查看 Composer Preview / 发布预览</a>
      <a class="button" href={base}>返回 Academic Door · 期刊</a>
    </div>
  </main>
</Layout>
