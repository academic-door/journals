---
import { readFileSync } from "node:fs";
import path from "node:path";
import Layout from "../../layouts/Layout.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const dataBase = import.meta.env.PUBLIC_JOURNAL_DATA_BASE || base;
const apiRoot = path.join(process.cwd(), "public", "api", "v1");
let initialIssue = null;
let initialJournal = "aer";
let initialIssueId = "";
try {
  const top5 = JSON.parse(
    readFileSync(path.join(apiRoot, "collections", "top5.json"), "utf-8"),
  );
  const journal = top5.journals?.find((item: any) => item.journal_id === "aer") || top5.journals?.[0];
  initialJournal = journal?.journal_id || "aer";
  initialIssueId = journal?.latest_issue_id || "";
  if (journal?.latest_issue_url) {
    const relative = String(journal.latest_issue_url).replace(/^.*\/api\/v1\//, "");
    initialIssue = JSON.parse(readFileSync(path.join(apiRoot, relative), "utf-8"));
  }
} catch {
  // Preview keeps its capability shell even when generated data is unavailable.
}
const privateComposer = "https://academic-door-composer.academic-door.workers.dev/";
---

<Layout
  title="Composer Preview / 发布预览 · Academic Door"
  description="查看期刊文章的手机端排版示例；编辑与发布准备可进入 Composer 工作台。"
>
  <main class="composer-preview-page" data-base={base} data-private-composer={privateComposer}>
    <section class="composer-preview-hero">
      <div>
        <p class="section-kicker">COMPOSER PREVIEW</p>
        <h1>发布预览</h1>
        <p>
          看看期刊文章整理后的手机端阅读效果。需要编辑、调整顺序或准备发布，
          可以进入 Composer 工作台。
        </p>
        <div class="composer-preview-actions">
          <a id="private-composer-link" class="button button-primary" href={privateComposer}>
            进入 Composer 工作台
          </a>
          <a class="button" href={`${base}top5/`}>返回顶刊之门</a>
        </div>
        <p class="composer-access-note">
          Composer 工作台需要登录。
        </p>
      </div>
    </section>

    <section class="composer-showcase" aria-labelledby="preview-title">
      <div class="section-heading editorial-heading">
        <div>
          <p class="section-kicker">ARTICLE PREVIEW</p>
          <h2 id="preview-title">文章排版示例</h2>
        </div>
        <p id="preview-context">以下展示部分期刊论文的排版效果。</p>
      </div>
      <div class="showcase-stage">
        <div class="phone-shell showcase-phone">
          <article id="composer-preview-card" class="public-composer-preview">
            <p class="preview-loading">正在载入代表性卷期……</p>
          </article>
        </div>
      </div>
    </section>
  </main>

  <script is:inline define:vars={{ base, dataBase, initialIssue, initialJournal, initialIssueId, privateComposer }}>
    const preview = document.querySelector("#composer-preview-card");
    const context = document.querySelector("#preview-context");
    const privateLink = document.querySelector("#private-composer-link");
    const params = new URLSearchParams(window.location.search);
    const journal = params.get("journal") || initialJournal;
    const issue = params.get("issue") || initialIssueId;

    const escapeHtml = (value = "") =>
      String(value).replace(/[&<>"']/g, (character) => ({
        "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;"
      })[character]);

    const privateUrl = new URL(privateComposer);
    if (journal) privateUrl.searchParams.set("journal", journal);
    if (issue) privateUrl.searchParams.set("issue", issue);
    privateLink.href = privateUrl.toString();

    const issueLabel = (payload = {}) => {
      const existing = String(payload.issue_label || "").trim();
      if (existing) return existing;
      const volume = String(payload.volume || "").trim();
      const number = String(payload.issue || "").trim();
      return [volume ? `Vol. ${volume}` : "", number ? `No. ${number}` : ""]
        .filter(Boolean).join(" · ");
    };

    const renderPreview = (payload) => {
      if (!payload?.articles?.length) {
        preview.innerHTML = '<p class="preview-loading">当前卷期预览暂不可用。</p>';
        return;
      }
      const articles = payload.articles
        .filter((article) => ["research-article", "comment", "short-communication"].includes(article.article_type || "research-article"))
        .slice(0, 3);
      const journalName = payload.journal_name || payload.journal_id?.toUpperCase() || "Journal";
      const label = issueLabel(payload);
      context.textContent = `${journalName} · ${label} · 展示 ${articles.length} 篇论文`;
      preview.innerHTML = `
        <p class="preview-brand">ACADEMIC DOOR · JOURNALS</p>
        <h1>${escapeHtml(journalName)} ${escapeHtml(label)}</h1>
        <h2>目录与摘要</h2>
        ${articles.map((article, index) => `
          <section class="preview-article">
            <p class="preview-article-index">${String(index + 1).padStart(2, "0")}</p>
            <h3>${escapeHtml(article.title_cn || article.title_en || "Untitled")}</h3>
            ${article.title_cn && article.title_en ? `<p class="preview-title-en">${escapeHtml(article.title_en)}</p>` : ""}
            <p class="preview-authors">${escapeHtml((article.authors || []).join(" · "))}</p>
            <p class="preview-abstract">${escapeHtml(article.abstract_cn || article.abstract_en || "")}</p>
          </section>
        `).join("")}
        <p class="preview-footnote">中文标题与摘要由 Academic Door 辅助翻译整理，正式引用请以期刊原文为准。</p>
      `;
    };

    const loadRequestedIssue = async () => {
      if (!journal || !issue) {
        renderPreview(initialIssue);
        return;
      }
      try {
        const response = await fetch(`${dataBase}api/v1/journals/${encodeURIComponent(journal)}/issues/${encodeURIComponent(issue)}.json`);
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        renderPreview(await response.json());
      } catch {
        renderPreview(initialIssue);
      }
    };

    loadRequestedIssue();
  </script>
</Layout>
