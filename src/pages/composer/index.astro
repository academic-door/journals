---
import Layout from "../../layouts/Layout.astro";
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout title="Academic Door Journals · 微信公众号编辑器">
  <main class="composer-page">
    <section class="page-heading composer-heading">
      <div>
        <p class="section-kicker">ACADEMIC DOOR</p>
        <h1>微信公众号编辑器</h1>
      </div>
      <span id="save-status" class="sr-only" aria-live="polite">就绪</span>
    </section>

    <section class="composer-toolbar" aria-label="Composer 工具栏">
      <label class="composer-source">
        <span>期刊</span>
        <select id="journal-select" aria-label="选择期刊"></select>
      </label>
      <label class="composer-source issue-select">
        <span>卷期</span>
        <select id="issue-select" aria-label="选择卷期"></select>
      </label>
      <button id="load-current" class="button button-primary" type="button">载入</button>
      <label class="composer-source theme-select">
        <span>主题</span>
        <select id="theme-select" aria-label="选择排版主题">
          <option value="wechat-default">学术传送门经典（默认）</option>
        </select>
      </label>
      <details class="style-settings">
        <summary class="button">排版设置</summary>
        <div class="style-settings-panel">
          <label>
            <span>正文字号</span>
            <select id="font-size-select">
              <option value="14">小（14px）</option>
              <option value="15">适中（15px）</option>
              <option value="16">标准（16px）</option>
              <option value="17">大（17px）</option>
            </select>
          </label>
          <label>
            <span>行距</span>
            <select id="line-height-select">
              <option value="1.65">紧凑</option>
              <option value="1.75" selected>舒适</option>
              <option value="1.9">宽松</option>
            </select>
          </label>
          <label>
            <span>字体</span>
            <select id="font-family-select">
              <option value="classic">经典</option>
              <option value="sans">现代黑体</option>
              <option value="serif">中文宋体</option>
            </select>
          </label>
          <label>
            <span>强调色</span>
            <input id="accent-color" type="color" value="#ef7060" />
          </label>
          <details class="custom-css-settings">
            <summary>自定义 CSS</summary>
            <label>
              <span>样式仅作用于正文预览，并在复制时转为行内样式</span>
              <textarea id="custom-css" rows="7" spellcheck="false" placeholder="例如：&#10;h3 { color: #1f6b57; }&#10;blockquote { border-radius: 8px; }"></textarea>
            </label>
            <small id="custom-css-status">支持普通选择器；不加载外部资源。</small>
          </details>
          <button id="reset-style" class="button" type="button">恢复经典默认</button>
        </div>
      </details>
      <a class="button theme-lab-link" href={`${base}themes/`}>主题实验室</a>
      <div class="toolbar-actions">
        <button id="copy-rich" class="button" type="button">复制富文本</button>
        <button id="copy-markdown" class="button" type="button">复制 Markdown</button>
        <button id="export-markdown" class="button" type="button">导出 Markdown</button>
        <button id="export-html" class="button" type="button">导出 HTML</button>
      </div>
    </section>
    <p id="publication-readiness" class="composer-readiness" aria-live="polite" hidden></p>

    <section class="composer-grid">
      <aside class="composer-sidebar">
        <div class="panel-heading">
          <p class="section-kicker">SOURCE</p>
          <h2>本期论文</h2>
        </div>
        <div class="picker-actions" aria-label="论文选择操作">
          <button id="select-china" class="button button-compact" type="button">仅保留中国相关</button>
          <button id="select-all" class="button button-compact" type="button">恢复全部</button>
        </div>
        <p class="sidebar-help">勾选决定最终内容；拖动或使用箭头调整顺序。</p>
        <div id="article-picker" class="article-picker">
          <p>载入期刊后显示论文。</p>
        </div>
        <button id="regenerate" class="button sidebar-button" type="button" disabled>重新生成正文</button>
      </aside>

      <section class="editor-panel">
        <div class="panel-heading">
          <p class="section-kicker">MARKDOWN</p>
          <h2>正文编辑</h2>
        </div>
        <textarea id="markdown-editor" spellcheck="false" aria-label="Markdown 正文"></textarea>
      </section>

      <section class="preview-panel">
        <div class="panel-heading">
          <p class="section-kicker">WECHAT PREVIEW</p>
          <h2>手机预览</h2>
        </div>
        <div class="phone-shell">
          <article id="wechat-preview" class="wechat-preview theme-wechat-default"></article>
        </div>
      </section>
    </section>
  </main>

  <style is:inline id="composer-custom-style"></style>

  <script is:inline define:vars={{ base }}>
    const STORAGE_KEY = "academic-door-composer-v1";
    const COMPOSER_FORMAT_VERSION = "3";
    const editor = document.querySelector("#markdown-editor");
    const preview = document.querySelector("#wechat-preview");
    const picker = document.querySelector("#article-picker");
    const regenerateButton = document.querySelector("#regenerate");
    const saveStatus = document.querySelector("#save-status");
    const readinessNotice = document.querySelector("#publication-readiness");
    const journalSelect = document.querySelector("#journal-select");
    const issueSelect = document.querySelector("#issue-select");
    const themeSelect = document.querySelector("#theme-select");
    const fontSizeSelect = document.querySelector("#font-size-select");
    const lineHeightSelect = document.querySelector("#line-height-select");
    const fontFamilySelect = document.querySelector("#font-family-select");
    const accentColor = document.querySelector("#accent-color");
    const customCss = document.querySelector("#custom-css");
    const customCssStatus = document.querySelector("#custom-css-status");
    const customStyle = document.querySelector("#composer-custom-style");
    const DEFAULT_STYLE = Object.freeze({
      fontSize: "14",
      lineHeight: "1.75",
      fontFamily: "classic",
      accent: "#ef7060",
      customCss: "",
    });
    const FONT_FAMILIES = {
      classic: 'Optima, "Microsoft YaHei", "PingFang SC", serif',
      sans: '"PingFang SC", "Microsoft YaHei", Arial, sans-serif',
      serif: '"Noto Serif SC", "Songti SC", SimSun, serif',
    };
    let collection = null;
    let currentIssue = null;
    let currentTheme = "wechat-default";
    let styleSettings = { ...DEFAULT_STYLE };
    let saveTimer = null;
    const issueCache = new Map();
    const historyCache = new Map();
    let issueOptionsRequest = 0;
    let pickerOrder = [];
    let selectedIds = new Set();
    let issuePreferences = {};
    const publishingButtons = [
      "#copy-rich",
      "#copy-markdown",
      "#export-markdown",
      "#export-html",
    ].map((selector) => document.querySelector(selector));

    const escapeHtml = (value = "") =>
      String(value).replace(/[&<>"']/g, (character) => ({
        "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;"
      }[character]));

    const chinaRelevance = (article) => {
      if (article.china_relevance?.status) return article.china_relevance;
      const title = `${article.title_en || ""} ${article.title_cn || ""}`;
      const abstract = `${article.abstract_en || ""} ${article.abstract_cn || ""}`;
      const strong = /(?:\b(?:evidence from|in|for|of|among|across)\s+(?:rural\s+)?China\b|\bChinese\s+(?:firms|households|cities|workers|students|manufacturers|exporters|provinces)\b|中国(?:企业|家庭|城市|农村|制造|出口|省份|劳动力|学生))/i;
      const titleMatch = /\bChina(?:'s|ese)?\b|\bChinese\b|中国|北京|上海|台湾|香港/i.test(title);
      const abstractMatch = strong.test(abstract);
      return { status: titleMatch || abstractMatch ? "yes" : "no" };
    };

    const issueReadiness = (issue) => {
      if (!issue) return { ready: false, total: 0, abstracts: 0, translations: 0 };
      const quality = issue.quality || {};
      const total = issue.research_article_count || issue.articles?.length || 0;
      const abstracts = quality.abstract_en_complete || 0;
      const translations = quality.translation_complete || 0;
      return {
        ready: issue.publication_state === "ready"
          || (total > 0 && abstracts === total && translations === total),
        total,
        abstracts,
        translations,
      };
    };

    const renderReadiness = () => {
      const readiness = issueReadiness(currentIssue);
      if (!currentIssue || readiness.ready) {
        readinessNotice.hidden = true;
        readinessNotice.textContent = "";
        readinessNotice.dataset.state = "ready";
        publishingButtons.forEach((button) => { button.disabled = false; });
        return;
      }
      const missingAbstracts = Math.max(0, readiness.total - readiness.abstracts);
      readinessNotice.hidden = false;
      readinessNotice.dataset.state = "enriching";
      readinessNotice.textContent = missingAbstracts > 0
        ? `等待英文摘要 · ${readiness.abstracts}/${readiness.total}；摘要补齐后自动进入翻译。`
        : `中文翻译中 · ${readiness.translations}/${readiness.total}；整理完成后即可复制发布。`;
      publishingButtons.forEach((button) => { button.disabled = true; });
    };

    const renderInline = (value) =>
      escapeHtml(value)
        .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
        .replace(/\[(.+?)\]\((https?:\/\/[^\s)]+)\)/g, '<a href="$2">$1</a>');

    const renderMarkdown = (markdown) => {
      const lines = markdown.replace(/\r\n/g, "\n").split("\n");
      const output = [];
      let listOpen = false;
      const closeList = () => {
        if (listOpen) output.push("</ol>");
        listOpen = false;
      };
      let inToc = false;
      for (let index = 0; index < lines.length; index += 1) {
        const rawLine = lines[index];
        const line = rawLine.trimEnd();
        if (!line.trim()) {
          closeList();
          continue;
        }
        const ordered = line.match(/^\s*(\d+)\.\s+(.+)$/);
        if (inToc && ordered) {
          closeList();
          const details = [];
          let cursor = index + 1;
          while (cursor < lines.length && details.length < 2) {
            const detail = lines[cursor].trim();
            if (!detail) {
              cursor += 1;
              continue;
            }
            if (/^\s*\d+\.\s+/.test(detail) || detail.startsWith("#")) break;
            details.push(detail);
            cursor += 1;
          }
          output.push(`<p class="toc-item">${ordered[1]}. ${renderInline(ordered[2])}${details[0] ? `<br/><span class="toc-title-cn">${renderInline(details[0])}</span>` : ""}${details[1] ? `<br/><span class="toc-authors">${renderInline(details[1])}</span>` : ""}</p>`);
          index = cursor - 1;
          continue;
        }
        if (ordered) {
          if (!listOpen) output.push("<ol>");
          listOpen = true;
          output.push(`<li>${renderInline(ordered[2])}</li>`);
          continue;
        }
        closeList();
        if (line.startsWith("### ")) {
          inToc = false;
          output.push(`<h3>${renderInline(line.slice(4))}</h3>`);
        } else if (line.startsWith("## ")) {
          const heading = line.slice(3);
          inToc = heading.includes("目录");
          output.push(`<h2><span class="heading-content">${renderInline(heading)}</span></h2>`);
        } else if (line.startsWith("# ")) {
          inToc = false;
          output.push(`<h1>${renderInline(line.slice(2))}</h1>`);
        } else if (line.startsWith("> ")) {
          const quotes = [line.slice(2)];
          let cursor = index + 1;
          while (cursor < lines.length && lines[cursor].trimStart().startsWith("> ")) {
            quotes.push(lines[cursor].trimStart().slice(2));
            cursor += 1;
          }
          output.push(`<blockquote>${quotes.map(renderInline).join("<br/>")}</blockquote>`);
          index = cursor - 1;
        } else if (line.startsWith("- ")) {
          output.push(`<p class="bullet">• ${renderInline(line.slice(2))}</p>`);
        } else {
          output.push(`<p>${renderInline(line.trim())}</p>`);
        }
      }
      closeList();
      return output.join("");
    };

    const formatIssuePeriod = (value = "") => {
      const raw = String(value).trim();
      if (!raw) return "";
      const iso = raw.match(/^(\d{4})-(\d{2})/);
      if (iso) return `${iso[1]} 年 ${Number(iso[2])} 月`;
      const month = raw.match(/^(January|February|March|April|May|June|July|August|September|October|November|December)\s+(\d{4})$/i);
      if (!month) return raw;
      const months = { january: 1, february: 2, march: 3, april: 4, may: 5, june: 6, july: 7, august: 8, september: 9, october: 10, november: 11, december: 12 };
      return `${month[2]} 年 ${months[month[1].toLowerCase()]} 月`;
    };

    const scopedCustomCss = (css) => {
      if (!css.trim()) return "";
      if (css.includes("\\")) throw new Error("不支持 CSS 转义序列");
      if (/@import|@font-face|url\s*\(|image-set\s*\(|expression\s*\(|javascript:|https?:|data:/i.test(css)) {
        throw new Error("不支持外部资源或可执行样式");
      }
      if (/@[a-z-]+/i.test(css)) throw new Error("暂不支持 @ 开头的 CSS 规则");
      const blocks = css.split("}").map((block) => block.trim()).filter(Boolean);
      return blocks.map((block) => {
        const boundary = block.indexOf("{");
        if (boundary < 1) throw new Error("CSS 规则缺少 { }");
        const selectors = block.slice(0, boundary).trim().split(",").map((selector) => {
          const value = selector.trim();
          if (!value) throw new Error("CSS 选择器不能为空");
          if (value.includes("#wechat-preview")) return value;
          if (value === ".wechat-preview" || value === ":root") return "#wechat-preview";
          return `#wechat-preview ${value}`;
        });
        return `${selectors.join(", ")} {${block.slice(boundary + 1)}}`;
      }).join("\n");
    };

    const applyStyleSettings = () => {
      const size = Number(styleSettings.fontSize) || Number(DEFAULT_STYLE.fontSize);
      preview.style.setProperty("--composer-body-size", `${size}px`);
      preview.style.setProperty("--composer-line-height", styleSettings.lineHeight);
      preview.style.setProperty("--composer-font-family", FONT_FAMILIES[styleSettings.fontFamily] || FONT_FAMILIES.classic);
      preview.style.setProperty("--composer-accent", styleSettings.accent);
      preview.style.setProperty("--composer-h1-size", `${size + 6}px`);
      preview.style.setProperty("--composer-h2-size", `${size + 6}px`);
      preview.style.setProperty("--composer-h3-size", `${size + 3}px`);
      try {
        customStyle.textContent = scopedCustomCss(styleSettings.customCss);
        customCssStatus.textContent = styleSettings.customCss.trim()
          ? "自定义样式已应用"
          : "支持普通选择器；不加载外部资源。";
        customCssStatus.classList.remove("error");
      } catch (error) {
        customStyle.textContent = "";
        customCssStatus.textContent = `未应用：${error.message}`;
        customCssStatus.classList.add("error");
      }
    };

    const syncStyleControls = () => {
      fontSizeSelect.value = styleSettings.fontSize;
      lineHeightSelect.value = styleSettings.lineHeight;
      fontFamilySelect.value = styleSettings.fontFamily;
      accentColor.value = styleSettings.accent;
      customCss.value = styleSettings.customCss;
    };

    const updatePreview = () => {
      preview.innerHTML = renderMarkdown(editor.value);
      preview.className = `wechat-preview theme-${currentTheme}`;
      applyStyleSettings();
    };

    const saveLocal = () => {
      if (currentIssue) {
        issuePreferences[currentIssue.issue_id] = {
          selected: [...selectedIds],
          order: [...pickerOrder],
        };
      }
      localStorage.setItem(STORAGE_KEY, JSON.stringify({
        formatVersion: COMPOSER_FORMAT_VERSION,
        markdown: editor.value,
        theme: currentTheme,
        styleSettings,
        journalId: currentIssue?.journal_id || journalSelect.value,
        issueUrl: issueSelect.value,
        issuePreferences,
        savedAt: new Date().toISOString(),
      }));
      saveStatus.textContent = "已保存";
    };

    const scheduleSave = () => {
      saveStatus.textContent = "正在保存…";
      clearTimeout(saveTimer);
      saveTimer = setTimeout(saveLocal, 350);
    };

    const orderedIssueArticles = (issue) => {
      const byId = new Map(issue.articles.map((article) => [article.paper_id, article]));
      const ordered = pickerOrder.map((paperId) => byId.get(paperId)).filter(Boolean);
      const orderedIds = new Set(ordered.map((article) => article.paper_id));
      return ordered.concat(issue.articles.filter((article) => !orderedIds.has(article.paper_id)));
    };

    const issueLabel = (issue = {}) => {
      const volume = String(issue.volume || "").trim();
      const number = String(issue.issue || "").trim();
      const existing = String(issue.issue_label || "").trim();
      const base = volume ? `Vol. ${volume}` : "";
      if (!number || number.toLowerCase() === "c") return base;
      if (existing) return existing;
      if (/^[ab]$/i.test(number)) return `${base} · Part ${number.toUpperCase()}`;
      if (/^\d+(?:\s*[-–]\s*\d+)?$/.test(number)) return `${base} · No. ${number}`;
      return [base, number].filter(Boolean).join(" · ");
    };

    const sanitizeSummaryIssueLabel = (value = "") =>
      String(value).replace(/\s*[·,]?\s*No\.\s*C\b/gi, "").trim();

    const publicationMonth = (value = "") => {
      const raw = String(value).trim();
      const iso = raw.match(/^(\d{4})-(\d{2})/);
      if (iso) return Number(iso[1]) * 100 + Number(iso[2]);
      const month = raw.match(/^(January|February|March|April|May|June|July|August|September|October|November|December)\s+(\d{4})$/i);
      if (!month) return 0;
      const months = { january: 1, february: 2, march: 3, april: 4, may: 5, june: 6, july: 7, august: 8, september: 9, october: 10, november: 11, december: 12 };
      return Number(month[2]) * 100 + months[month[1].toLowerCase()];
    };

    const issuePeriodLine = (issue, period) => {
      if (!period) return "";
      if (issue.publication_state !== "enriching") return `> ${period}`;
      const now = new Date();
      const currentMonth = now.getFullYear() * 100 + now.getMonth() + 1;
      return publicationMonth(issue.publication_date) > currentMonth
        ? `> 预计 ${period} · 本卷仍在持续更新`
        : `> ${period} · 内容补全中`;
    };

    const articleMarkdown = (issue, selected) => {
      const articles = orderedIssueArticles(issue).filter((article) => selected.has(article.paper_id));
      const chinaArticles = arti…159 tokens truncated…[
            issuePeriodLine(issue, period),
            `> ${issue.journal_name} ${issueLabel(issue)} ${issue.publication_state === "enriching" ? "当前已收录" : "共收录"} ${issueCountLabel}。`,
            articles.length !== issueArticleCount ? `> 本次选取其中 ${articles.length} 篇。` : "",
            chinaArticles.length ? `> 与中国相关的研究有 ${chinaArticles.length} 篇（第 ${chinaArticles.map((article) => articles.indexOf(article) + 1).join("、")} 篇）。` : "",
          ].filter(Boolean).join("\n");
      const toc = articles.map((article, index) =>
        `${index + 1}. **${article.title_en}**\n   ${article.title_cn || "中文标题待补全"}\n   ${article.authors.join(", ")}`
      ).join("\n\n");
      const abstracts = articles.map((article, index) => [
        `### ${index + 1}. ${article.title_cn || article.title_en}`,
        `【作者】${article.authors.join(", ")}`,
        `【Abstract】${article.abstract_en || (article.article_type === "comment" ? "This comment has no standalone abstract." : "待补全")}`,
        `【摘要】${article.abstract_cn || (article.article_type === "comment" ? "该评论未提供独立摘要。" : "待补全")}`,
        `【DOI】[${article.doi || "原文"}](${article.source_url})`,
      ].join("\n\n")).join("\n\n");
      return [
        `# ${issue.journal_name} ${issueLabel(issue)} 目录与摘要`,
        intro,
        "## 一、目录",
        toc,
        "## 二、摘要",
        abstracts,
        "> 中文内容由 AI 辅助翻译和人工整理，仅供学术交流。论文信息请以原文为准。",
      ].join("\n\n");
    };

    const renderPicker = () => {
      if (!currentIssue) return;
      picker.innerHTML = orderedIssueArticles(currentIssue).map((article, index) => `
        <div class="article-choice" draggable="true" data-paper-id="${escapeHtml(article.paper_id)}">
          <span class="drag-handle" aria-hidden="true">⋮⋮</span>
          <label>
            <input type="checkbox" value="${escapeHtml(article.paper_id)}" ${selectedIds.has(article.paper_id) ? "checked" : ""} />
            <span>
              <strong>${index + 1}. ${escapeHtml(article.title_cn || article.title_en)}</strong>
              <small>${escapeHtml(article.title_en)}</small>
            </span>
          </label>
          <span class="move-actions">
            <button type="button" data-move="-1" aria-label="上移《${escapeHtml(article.title_cn || article.title_en)}》" ${index === 0 ? "disabled" : ""}>↑</button>
            <button type="button" data-move="1" aria-label="下移《${escapeHtml(article.title_cn || article.title_en)}》" ${index === pickerOrder.length - 1 ? "disabled" : ""}>↓</button>
          </span>
        </div>`).join("");
      regenerateButton.disabled = false;
    };

    const regenerateFromSelection = () => {
      if (!currentIssue) return;
      editor.value = articleMarkdown(currentIssue, selectedIds);
      updatePreview();
      saveLocal();
    };

    const applyPickerPreference = () => {
      const allIds = currentIssue.articles.map((article) => article.paper_id);
      const saved = issuePreferences[currentIssue.issue_id] || {};
      const validIds = new Set(allIds);
      pickerOrder = Array.isArray(saved.order)
        ? saved.order.filter((paperId) => validIds.has(paperId))
        : [];
      pickerOrder.push(...allIds.filter((paperId) => !pickerOrder.includes(paperId)));
      selectedIds = Array.isArray(saved.selected)
        ? new Set(saved.selected.filter((paperId) => validIds.has(paperId)))
        : new Set(allIds);
    };

    const loadCollection = async () => {
      const collections = await Promise.all(["top5", "fields"].map((collectionId) =>
        fetch(`${base}api/v1/collections/${collectionId}.json`).then((response) => {
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          return response.json();
        })
      ));
      const seen = new Set();
      collection = {
        journals: collections.flatMap((item) => item.journals || []).filter((journal) => {
          if (seen.has(journal.journal_id)) return false;
          seen.add(journal.journal_id);
          return true;
        }),
      };
      const journals = collection.journals.filter(
        (journal) => journal.latest_issue_url || journal.latest_detected_issue_url
      );
      journalSelect.innerHTML = journals.map((journal) =>
        `<option value="${escapeHtml(journal.journal_id)}">${escapeHtml(journal.short_name)}</option>`
      ).join("");
      const requested = new URLSearchParams(window.location.search).get("journal");
      if (requested && journals.some((journal) => journal.journal_id === requested)) {
        journalSelect.value = requested;
      }
      renderIssueOptions().catch((error) => {
        saveStatus.textContent = `卷期载入失败：${error.message}`;
      });
    };
    const fetchIssue = (url) => {
      if (!issueCache.has(url)) {
        issueCache.set(url, fetch(url).then((response) => {
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          return response.json();
        }));
      }
      return issueCache.get(url);
    };

    const fetchIssueHistory = async (journal) => {
      if (!journal) return [];
      if (!historyCache.has(journal.journal_id)) {
        const url = `${base}api/v1/journals/${journal.journal_id}/issues/index.json`;
        historyCache.set(journal.journal_id, fetch(url).then((response) => {
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          return response.json();
        }).then((payload) => payload.issues || []).catch(() => []));
      }
      return historyCache.get(journal.journal_id);
    };

    const immediateIssueOptionsFor = (journal) => {
      const ready = journal?.latest_issue_url ? [{
        id: journal.latest_issue_id || "current",
        url: journal.latest_issue_url,
        label: sanitizeSummaryIssueLabel(journal.latest_issue_label) || "最新一期",
        status: "ready",
        latest: false,
      }] : [];
      const detectedId = journal?.latest_detected_issue_id;
      const detected = journal?.latest_detected_issue_url
        && (
          detectedId !== journal.latest_issue_id
          || journal.latest_detected_issue_url !== journal.latest_issue_url
        )
        ? [{
            id: detectedId || "detected",
            url: journal.latest_detected_issue_url,
            label: sanitizeSummaryIssueLabel(journal.latest_detected_issue_label) || "最新卷期",
            status: "enriching",
            latest: true,
          }]
        : [];
      if (detected.length) return detected.concat(ready);
      return ready.map((issue) => ({ ...issue, latest: true }));
    };

    const issueOptionsFor = async (journal) => {
      const immediate = immediateIssueOptionsFor(journal);
      const history = await fetchIssueHistory(journal);
      const excludedIds = new Set(immediate.map((issue) => issue.id).filter(Boolean));
      const archived = history.filter((issue) => !excludedIds.has(issue.issue_id)).map((issue, index) => ({
        id: issue.issue_id || `issue-${index}`,
        url: issue.url,
        label: [
          issueLabel(issue),
          formatIssuePeriod(issue.publication_date),
        ].filter(Boolean).join(" · "),
        status: "archive",
        latest: false,
      })).filter((issue) => issue.url);
      return immediate.concat(archived);
    };

    const paintIssueOptions = (issues, preferredUrl = "") => {
      issueSelect.innerHTML = issues.map((issue) =>
        `<option value="${escapeHtml(issue.url)}" data-issue-id="${escapeHtml(issue.id)}" data-status="${escapeHtml(issue.status)}">${issue.latest ? "最新 · " : ""}${escapeHtml(issue.label)}</option>`
      ).join("");
      if (preferredUrl && issues.some((issue) => issue.url === preferredUrl)) {
        issueSelect.value = preferredUrl;
      }
      issueSelect.disabled = issues.length === 0;
      issueSelect.title = issues.length === 1 ? "目前仅收录这一期" : "选择卷期";
      document.querySelector("#load-current").disabled = issues.length === 0;
    };

    const renderIssueOptions = async (preferredUrl = "") => {
      const requestId = ++issueOptionsRequest;
      const journal = collection?.journals.find(
        (item) => item.journal_id === journalSelect.value
      );
      const journalId = journal?.journal_id;
      const immediate = immediateIssueOptionsFor(journal);
      paintIssueOptions(immediate, preferredUrl);
      immediate.forEach((issue) => fetchIssue(issue.url).catch(() => null));
      const issues = await issueOptionsFor(journal);
      if (requestId !== issueOptionsRequest || journalSelect.value !== journalId) return issues;
      paintIssueOptions(issues, preferredUrl || issueSelect.value);
      return issues;
    };
    const loadIssue = async (force = false) => {
      if (!force && editor.value.trim() && !confirm("载入本期数据会覆盖当前正文，是否继续？")) return;
      const journal = collection?.journals.find(
        (item) => item.journal_id === journalSelect.value
      );
      const issueUrl = issueSelect.value || journal?.latest_issue_url;
      if (!issueUrl) throw new Error("该期刊尚无可用数据");
      saveStatus.textContent = `正在载入 ${journal.short_name}…`;
      currentIssue = await fetchIssue(issueUrl);
      const selectedOption = issueSelect.options[issueSelect.selectedIndex];
      if (selectedOption && issueSelect.options.length === 1) {
        selectedOption.textContent = `${issueLabel(currentIssue)}（最新）`;
      }
      applyPickerPreference();
      renderPicker();
      editor.value = articleMarkdown(currentIssue, selectedIds);
      updatePreview();
      renderReadiness();
      saveLocal();
    };

    const download = (name, type, content) => {
      const url = URL.createObjectURL(new Blob([content], { type }));
      const link = document.createElement("a");
      link.href = url;
      link.download = name;
      link.click();
      URL.revokeObjectURL(url);
    };

    const cloneWithInlineStyles = (root) => {
      const clone = root.cloneNode(true);
      const originalNodes = [root, ...root.querySelectorAll("*")];
      const cloneNodes = [clone, ...clone.querySelectorAll("*")];
      const properties = [
        "color", "backgroundColor", "fontFamily", "fontSize", "fontWeight",
        "fontStyle", "lineHeight", "textAlign", "letterSpacing",
        "textShadow", "webkitBoxReflect",
        "marginTop", "marginRight", "marginBottom", "marginLeft",
        "paddingTop", "paddingRight", "paddingBottom", "paddingLeft",
        "borderTop", "borderRight", "borderBottom", "borderLeft",
        "borderRadius", "display", "textDecoration", "boxShadow", "boxSizing",
        "overflowX", "overflowY", "whiteSpace", "listStyleType", "verticalAlign",
        "opacity", "textIndent", "wordBreak"
      ];
      originalNodes.forEach((node, index) => {
        const computed = getComputedStyle(node);
        cloneNodes[index].removeAttribute("class");
        cloneNodes[index].style.cssText = properties
          .map((property) => {
            const cssProperty = property === "webkitBoxReflect"
              ? "-webkit-box-reflect"
              : property.replace(/[A-Z]/g, (letter) => `-${letter.toLowerCase()}`);
            const value = property === "webkitBoxReflect"
              ? computed.getPropertyValue("-webkit-box-reflect")
              : computed[property];
            return `${cssProperty}:${value}`;
          })
          .join(";");
      });
      return clone.innerHTML;
    };

    const copyRichText = async () => {
      const html = cloneWithInlineStyles(preview);
      const text = preview.innerText;
      if (window.ClipboardItem && navigator.clipboard?.write) {
        await navigator.clipboard.write([
          new ClipboardItem({
            "text/html": new Blob([html], { type: "text/html" }),
            "text/plain": new Blob([text], { type: "text/plain" }),
          }),
        ]);
      } else {
        const range = document.createRange();
        range.selectNodeContents(preview);
        const selection = window.getSelection();
        selection.removeAllRanges();
        selection.addRange(range);
        document.execCommand("copy");
        selection.removeAllRanges();
      }
      saveStatus.textContent = "富文本已复制，可粘贴到微信后台";
    };

    editor.addEventListener("input", () => {
      updatePreview();
      scheduleSave();
    });
    document.querySelector("#load-current").addEventListener("click", () => loadIssue());
    journalSelect.addEventListener("change", () => renderIssueOptions().catch((error) => {
      saveStatus.textContent = `卷期载入失败：${error.message}`;
    }));
    picker.addEventListener("change", (event) => {
      if (!event.target.matches('input[type="checkbox"]')) return;
      if (event.target.checked) selectedIds.add(event.target.value);
      else selectedIds.delete(event.target.value);
      regenerateFromSelection();
    });
    picker.addEventListener("click", (event) => {
      const button = event.target.closest("button[data-move]");
      if (!button) return;
      const choice = button.closest("[data-paper-id]");
      const from = pickerOrder.indexOf(choice.dataset.paperId);
      const to = from + Number(button.dataset.move);
      if (from < 0 || to < 0 || to >= pickerOrder.length) return;
      [pickerOrder[from], pickerOrder[to]] = [pickerOrder[to], pickerOrder[from]];
      renderPicker();
      regenerateFromSelection();
    });
    let draggedPaperId = "";
    picker.addEventListener("dragstart", (event) => {
      const choice = event.target.closest("[data-paper-id]");
      if (!choice) return;
      draggedPaperId = choice.dataset.paperId;
      event.dataTransfer.effectAllowed = "move";
    });
    picker.addEventListener("dragover", (event) => {
      if (event.target.closest("[data-paper-id]")) event.preventDefault();
    });
    picker.addEventListener("drop", (event) => {
      const target = event.target.closest("[data-paper-id]");
      if (!target || !draggedPaperId || target.dataset.paperId === draggedPaperId) return;
      event.preventDefault();
      const from = pickerOrder.indexOf(draggedPaperId);
      const to = pickerOrder.indexOf(target.dataset.paperId);
      pickerOrder.splice(from, 1);
      pickerOrder.splice(to, 0, draggedPaperId);
      renderPicker();
      regenerateFromSelection();
      draggedPaperId = "";
    });
    document.querySelector("#select-china").addEventListener("click", () => {
      if (!currentIssue) return;
      const chinaIds = currentIssue.articles
        .filter((article) => chinaRelevance(article).status === "yes")
        .map((article) => article.paper_id);
      if (!chinaIds.length) {
        saveStatus.textContent = "本期未识别到中国相关论文";
        return;
      }
      selectedIds = new Set(chinaIds);
      renderPicker();
      regenerateFromSelection();
    });
    document.querySelector("#select-all").addEventListener("click", () => {
      if (!currentIssue) return;
      selectedIds = new Set(currentIssue.articles.map((article) => article.paper_id));
      renderPicker();
      regenerateFromSelection();
    });
    regenerateButton.addEventListener("click", regenerateFromSelection);
    themeSelect.addEventListener("change", () => {
      currentTheme = themeSelect.value;
      updatePreview();
      saveLocal();
    });
    [fontSizeSelect, lineHeightSelect, fontFamilySelect, accentColor].forEach((control) => {
      control.addEventListener("input", () => {
        styleSettings = {
          ...styleSettings,
          fontSize: fontSizeSelect.value,
          lineHeight: lineHeightSelect.value,
          fontFamily: fontFamilySelect.value,
          accent: accentColor.value,
        };
        updatePreview();
        scheduleSave();
      });
    });
    customCss.addEventListener("input", () => {
      styleSettings = { ...styleSettings, customCss: customCss.value };
      updatePreview();
      scheduleSave();
    });
    document.querySelector("#reset-style").addEventListener("click", () => {
      styleSettings = { ...DEFAULT_STYLE };
      syncStyleControls();
      updatePreview();
      saveLocal();
    });
    document.querySelector("#copy-rich").addEventListener("click", () =>
      copyRichText().catch((error) => {
        saveStatus.textContent = `复制失败：${error.message}`;
      })
    );
    document.querySelector("#copy-markdown").addEventListener("click", async () => {
      await navigator.clipboard.writeText(editor.value);
      saveStatus.textContent = "Markdown 已复制";
    });
    document.querySelector("#export-markdown").addEventListener("click", () =>
      download("academic-door-draft.md", "text/markdown;charset=utf-8", editor.value)
    );
    document.querySelector("#export-html").addEventListener("click", () => {
      const html = `<!doctype html><meta charset="utf-8"><article>${cloneWithInlineStyles(preview)}</article>`;
      download("academic-door-draft.html", "text/html;charset=utf-8", html);
    });

    const initialize = async () => {
      await loadCollection();
      let state = null;
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) {
        try {
          state = JSON.parse(saved);
          issuePreferences = state.issuePreferences && typeof state.issuePreferences === "object"
            ? state.issuePreferences
            : {};
          currentTheme = Array.from(themeSelect.options).some(
            (option) => option.value === state.theme
          ) ? state.theme : "wechat-default";
          styleSettings = { ...DEFAULT_STYLE, ...(state.styleSettings || {}) };
          themeSelect.value = currentTheme;
          syncStyleControls();
        } catch {
          state = null;
        }
      }
      const requestedParams = new URLSearchParams(window.location.search);
      const requestedJournal = requestedParams.get("journal");
      const requestedIssue = requestedParams.get("issue");
      if (requestedJournal) {
        if (requestedIssue) {
          await renderIssueOptions();
          const requestedOption = Array.from(issueSelect.options).find(
            (option) => option.dataset.issueId === requestedIssue
          );
          if (requestedOption) issueSelect.value = requestedOption.value;
        }
        await loadIssue(true);
        return;
      }
      if (!state) {
        await loadIssue(true);
        return;
      }
      try {
        if (
          state.journalId
          && collection.journals.some(
            (journal) => journal.journal_id === state.journalId && journal.latest_issue_url
          )
        ) {
          journalSelect.value = state.journalId;
          await renderIssueOptions(state.issueUrl || "");
        }
        await loadIssue(true);
        if (state.formatVersion === COMPOSER_FORMAT_VERSION) {
          editor.value = state.markdown || editor.value;
          saveStatus.textContent = "已恢复上次草稿";
          updatePreview();
        } else {
          saveStatus.textContent = "排版已更新，正文已重新生成";
        }
      } catch {
        await loadIssue(true);
      }
    };

    syncStyleControls();
    initialize().catch((error) => {
      saveStatus.textContent = `期刊载入失败：${error.message}`;
    });
  </script>
</Layout>

