---
import { readFileSync } from "node:fs";
import path from "node:path";
import Layout from "../../layouts/Layout.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const dataBase = import.meta.env.PUBLIC_JOURNAL_DATA_BASE || base;
const apiRoot = path.join(process.cwd(), "public", "api", "v1");
const readJson = <T,>(relative: string, fallback: T): T => {
  try {
    return JSON.parse(readFileSync(path.join(apiRoot, relative), "utf-8"));
  } catch {
    return fallback;
  }
};
const top5 = readJson("collections/top5.json", { journals: [] });
const fields = readJson("collections/fields.json", { journals: [] });
const monitoring = readJson("monitoring.json", { status: "unknown", summary: {} });
const sourceAudit = readJson("source-audit.json", { status: "unknown", summary: {} });
const backfill = readJson("backfill-status.json", { coverage: {} });
const journals: any[] = [...(top5.journals || []), ...(fields.journals || [])];
const coverage = backfill.coverage || {};
const sourceAccepted = journals.filter((journal) =>
  ["official_verified", "publisher_verified"].includes(journal.source_status)
).length;
const officialOrder = journals.filter(
  (journal) => journal.order_verification === "official_verified"
).length;
const orderPending = Math.max(0, journals.length - officialOrder);
const failed = Number(monitoring.summary?.failed || 0);
const awaitingOfficial = Number(monitoring.summary?.awaiting_official || 0);
const readyIssues = Number(coverage.publication_ready || 0);
const missingIssues = Number(coverage.missing || 0);
const sourcePendingIssues = Number(coverage.source_pending || 0);
const statusHealthy = failed === 0 && Number(sourceAudit.summary?.needs_attention || 0) === 0;
const formatTime = (value: unknown) => {
  if (!value) return "未知";
  try {
    return new Intl.DateTimeFormat("zh-CN", {
      year: "numeric", month: "2-digit", day: "2-digit",
      hour: "2-digit", minute: "2-digit", hour12: false,
      timeZone: "UTC",
    }).format(new Date(String(value))) + " UTC";
  } catch {
    return String(value);
  }
};
---

<Layout
  title="数据状态 · Academic Door 期刊"
  description="Academic Door 期刊公开数据的可用性、历史覆盖、来源核验与更新监测状态。"
>
  <main class="public-status-page">
    <section class="status-hero">
      <div>
        <p class="section-kicker">DATA RELIABILITY</p>
        <h1>数据状态</h1>
        <p>
          这里展示读者真正需要知道的公开数据状态。采集器、checkpoint、transport 等内部诊断细节
          不作为读者层面的“完整率”。
        </p>
      </div>
      <div class:list={["status-beacon", { healthy: statusHealthy }]}>
        <span aria-hidden="true"></span>
        <strong>{statusHealthy ? "公开数据运行正常" : "部分数据正在更新"}</strong>
        <small>监测失败 {failed} · 来源需人工关注 {Number(sourceAudit.summary?.needs_attention || 0)}</small>
      </div>
    </section>

    <section class="status-metric-grid" aria-label="公开数据核心状态">
      <article>
        <p>JOURNALS</p>
        <strong>{journals.length}</strong>
        <span>监测期刊</span>
      </article>
      <article>
        <p>HISTORY READY</p>
        <strong>{readyIssues}</strong>
        <span>历史卷期可发布</span>
      </article>
      <article class:list={[{ attention: missingIssues > 0 }]}>
        <p>CONFIRMED MISSING</p>
        <strong>{missingIssues}</strong>
        <span>确认缺失卷期</span>
      </article>
      <article class:list={[{ attention: sourcePendingIssues > 0 }]}>
        <p>SOURCE PENDING</p>
        <strong>{sourcePendingIssues}</strong>
        <span>来源待核验卷期</span>
      </article>
    </section>

    <section class="status-detail-grid">
      <article class="status-detail-card">
        <p class="section-kicker">SOURCE TRUST</p>
        <h2>来源与目录核验分开计算</h2>
        <dl>
          <div>
            <dt>达到当前可发布来源契约</dt>
            <dd>{sourceAccepted} / {journals.length}</dd>
          </div>
          <div>
            <dt>目录顺序已官方核对</dt>
            <dd>{officialOrder} / {journals.length}</dd>
          </div>
          <div>
            <dt>目录顺序待官方复核</dt>
            <dd>{orderPending}</dd>
          </div>
        </dl>
        <p>
          “来源可发布”不等于“目录顺序已由官方页面逐项核验”。两者在 Academic Door 中保持独立语义。
        </p>
      </article>

      <article class="status-detail-card">
        <p class="section-kicker">FRESHNESS</p>
        <h2>完整性必须带时间语境</h2>
        <p id="expected-set-freshness">
          历史缺失数字针对最近一次已建立权威 expected set 的范围；正在读取当前 freshness 语境……
        </p>
        <dl>
          <div>
            <dt>等待官方新一期确认</dt>
            <dd>{awaitingOfficial}</dd>
          </div>
          <div>
            <dt>监测失败</dt>
            <dd>{failed}</dd>
          </div>
        </dl>
      </article>
    </section>

    <section class="status-scope-note" aria-labelledby="scope-title">
      <div>
        <p class="section-kicker">WHAT THESE NUMBERS MEAN</p>
        <h2 id="scope-title">公开状态不是内部运维仪表盘</h2>
      </div>
      <div class="status-scope-copy">
        <p>
          <strong>确认缺失</strong>：在当前已建立权威 expected set 的范围内，官方应有但 canonical archive 尚不存在的卷期。
        </p>
        <p>
          <strong>来源待核验</strong>：内容可能已经发现，但尚未达到当前 source-authority 发布契约。
        </p>
        <p>
          <strong>监测正常</strong>：监测任务可以运行，不代表每家出版社在同一时刻都有最新 authoritative observation。
        </p>
      </div>
    </section>

    <section class="status-meta">
      <span>历史覆盖更新：{formatTime(backfill.updated_at)}</span>
      <span>监测更新：{formatTime(monitoring.updated_at)}</span>
      <span>来源审计更新：{formatTime(sourceAudit.updated_at)}</span>
    </section>
  </main>

  <script is:inline define:vars={{ dataBase }}>
    const target = document.querySelector("#expected-set-freshness");
    fetch(`${dataBase}api/v1/slo.json`)
      .then((response) => {
        if (!response.ok) throw new Error("SLO unavailable");
        return response.json();
      })
      .then((payload) => {
        const metric = payload.metrics?.expected_set_freshness || {};
        const measured = Number(metric.measured_count || 0);
        const current = Number(metric.current_to_audit_end_count || 0);
        const stale = Number(metric.stale_for_audit_end_count || 0);
        if (!target || !measured) return;
        target.textContent =
          `当前 ${measured} 本期刊拥有权威 expected-set 测量；其中 ${current} 本测量至当前审计日，${stale} 本的权威测量时间较早。页面中的确认缺失数字只描述这些已建立 authority 的测量范围，不代表出版社未来尚未发布的卷期。`;
      })
      .catch(() => {
        if (target) {
          target.textContent =
            "历史缺失数字针对最近一次已建立权威 expected set 的范围；当前 freshness 明细暂不可用。";
        }
      });
  </script>
</Layout>
