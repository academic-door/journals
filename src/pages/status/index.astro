---
import { readFileSync } from "node:fs";
import path from "node:path";
import Layout from "../../layouts/Layout.astro";

const apiRoot = path.join(process.cwd(), "public", "api", "v1");
const readJson = <T,>(relative: string, fallback: T): T => {
  try {
    return JSON.parse(readFileSync(path.join(apiRoot, relative), "utf-8"));
  } catch {
    return fallback;
  }
};
const top5 = readJson("collections/top5.json", { journals: [] as any[] });
const fields = readJson("collections/fields.json", { journals: [] as any[] });
const backfill = readJson("backfill-status.json", {
  updated_at: "",
  coverage: { publication_ready: 0, missing: 0 },
});
const journals = [...(top5.journals || []), ...(fields.journals || [])];
const readyIssues = Number(backfill.coverage?.publication_ready || 0);
const missingIssues = Number(backfill.coverage?.missing || 0);
const updateDate = backfill.updated_at
  ? new Intl.DateTimeFormat("zh-CN", {
      year: "numeric", month: "long", day: "numeric",
      timeZone: "UTC",
    }).format(new Date(String(backfill.updated_at)))
  : "暂无";
---

<Layout
  title="数据说明 · Academic Door 期刊"
  description="Academic Door 期刊数据的收录范围、出版来源与最近更新日期。"
>
  <main class="public-status-page">
    <section class="status-hero">
      <div>
        <p class="section-kicker">ABOUT THE DATA</p>
        <h1>数据说明</h1>
        <p>本站整理经济学期刊的卷期目录、论文标题与摘要。数据统计以最近一次更新为准。</p>
      </div>
    </section>

    <section class="status-metric-grid" aria-label="当前收录范围">
      <article>
        <p>JOURNALS</p>
        <strong>{journals.length}</strong>
        <span>收录期刊</span>
      </article>
      <article>
        <p>ISSUES</p>
        <strong>{readyIssues}</strong>
        <span>已收录卷期</span>
      </article>
      <article class:list={[{ attention: missingIssues > 0 }]}>
        <p>TO BE ADDED</p>
        <strong>{missingIssues}</strong>
        <span>已确认尚未收录的卷期</span>
      </article>
    </section>

    <section class="status-scope-note" aria-labelledby="scope-title">
      <div>
        <p class="section-kicker">DATA SOURCES</p>
        <h2 id="scope-title">来源与更新</h2>
      </div>
      <div class="status-scope-copy">
        <p>卷期和论文信息依据期刊官网、出版社的公开出版资料整理；中文标题与摘要由 Academic Door 辅助翻译。</p>
        <p>新一期内容可能需要核对后才会显示。上方“尚未收录”仅指已在官方目录中确认、但本站尚未完整收录的卷期。</p>
        <p>数据最近更新：{updateDate}（UTC 日期）。引用与版权信息请以期刊原文为准。</p>
      </div>
    </section>
  </main>
</Layout>
