---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  workspace?: boolean;
  noindex?: boolean;
}

const {
  title = "Academic Door · 期刊",
  description = "Academic Door 顶刊之门与领域之门：经济学期刊卷期、双语摘要与跨刊检索。",
  workspace = false,
  noindex = false,
} = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const pathname = Astro.url.pathname;
const previewMode = import.meta.env.PUBLIC_PREVIEW_MODE === "1";
const canonical = `https://academic-door.github.io${pathname.endsWith("/") ? pathname : `${pathname}/`}`;
const navItems = [
  { href: `${base}top5/`, label: "顶刊之门", match: "/journals/top5/" },
  { href: `${base}fields/`, label: "领域之门", match: "/journals/fields/" },
  { href: `${base}search/`, label: "跨刊检索", match: "/journals/search/" },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#173f35" />
    <meta
      name="robots"
      content={previewMode ? "noindex,nofollow,noarchive" : noindex ? "noindex,follow" : "index,follow"}
    />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Academic Door" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://academic-door.github.io/assets/academic-door-logo.png" />
    <link rel="icon" type="image/png" href="https://academic-door.github.io/assets/academic-door-mark.png" />
    <link rel="apple-touch-icon" href="https://academic-door.github.io/assets/academic-door-mark.png" />
    <title>{title}</title>
  </head>
  <body class={workspace ? "workspace-layout" : undefined}>
    {previewMode && (
      <div class="preview-banner" role="status">
        Preview · G12 Public UX Reset · 仅供验收，当前生产站未切换
      </div>
    )}
    <header class="site-header">
      <div class="brand-stack" aria-label="Academic Door 期刊">
        <a class="parent-brand" href="https://academic-door.github.io/" aria-label="返回 Academic Door 门厅">
          <img
            src="https://academic-door.github.io/assets/academic-door-mark.png"
            alt=""
            width="40"
            height="40"
          />
          <span>Academic Door</span>
        </a>
        <span class="brand-separator" aria-hidden="true">/</span>
        <a class="child-brand" href={base}>期刊</a>
      </div>
      <nav class="reader-nav" aria-label="期刊主导航">
        {navItems.map((item) => (
          <a
            href={item.href}
            aria-current={pathname.startsWith(item.match) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="footer-brand">
        <strong>Academic Door · 期刊</strong>
        <span>顶刊之门与领域之门，共享同一套可追溯期刊数据。</span>
      </div>
      <nav class="footer-links" aria-label="期刊辅助链接">
        <a href={`${base}status/`}>数据状态</a>
        <a href={`${base}composer/`}>Composer Preview / 发布预览</a>
        <a href="https://academic-door.github.io/">Academic Door 门厅</a>
      </nav>
      <p class="footer-disclaimer">论文信息与版权以期刊官网和原文为准。</p>
      <p class="translation-provenance">
        中文标题与摘要由 Academic Door 辅助翻译整理；研究引用与正式判断请以期刊原文为准。
      </p>
    </footer>
  </body>
</html>
